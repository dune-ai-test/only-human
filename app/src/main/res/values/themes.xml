<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-Compose window theme. Matches the app's system background so there is no flash. -->
    <style name="Theme.OnlyHuman" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
